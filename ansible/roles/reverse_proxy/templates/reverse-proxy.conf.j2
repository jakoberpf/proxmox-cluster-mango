# Managed by Ansible (reverse_proxy role).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ proxy_listen_address }}:{{ proxy_https_port }} ssl;
    server_name {{ proxy_server_name }};

    ssl_certificate {{ proxy_letsencrypt_dir }}/fullchain.pem;
    ssl_certificate_key {{ proxy_letsencrypt_dir }}/privkey.pem;

    # Large git pushes and artifacts.
    client_max_body_size 0;

    location / {
        proxy_pass {{ proxy_upstream }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl on;

        # WebSockets (GitLab live logs and web terminal).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }
}
{% if proxy_http_redirect | bool %}
server {
    listen {{ proxy_listen_address }}:80;
    server_name {{ proxy_server_name }};

    return 301 https://$host$request_uri;
}
{% endif %}
