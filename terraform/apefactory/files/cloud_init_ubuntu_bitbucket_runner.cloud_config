#cloud-config

# create the docker group
groups:
  - docker

# Add default auto created user to docker group
system_info:
  default_user:
    groups: [docker]

users:
  - default
  - name: jakoberpf
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
      - ${ssh_key}

apt:
  sources:
    docker.list:
      source: deb [arch=amd64] https://download.docker.com/linux/ubuntu $RELEASE stable
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88

packages:
  - apt-transport-https
  - ca-certificates
  - curl
  - gnupg-agent
  - software-properties-common
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - qemu-guest-agent

runcmd:
  - systemctl start qemu-guest-agent
  # Setup Zerotier
  - curl -o zerotier-install.sh https://raw.githubusercontent.com/jakoberpf/zerotier-scripts/main/zerotier-installer.sh
  - chmod +x zerotier-install.sh
  - ./zerotier-install.sh
  - zerotier-cli join ${zerotier_network_id}
  # Setup Bitbucket Runners

  # -- portal
  - docker container run -d -v /tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/containers:/var/lib/docker/containers:ro -e ACCOUNT_UUID={d5fe0152-2862-467e-8cc1-75c643d992bd} -e REPOSITORY_UUID={a008cf56-6549-4df5-9ead-55817e195d80} -e RUNNER_UUID={07a3e0c6-1477-52e7-aa90-c5ae699d05fb} -e RUNTIME_PREREQUISITES_ENABLED=true -e OAUTH_CLIENT_ID=tBSNVeEeEIy0stVq9wxAYiMy3CqyE12b -e OAUTH_CLIENT_SECRET=ZJudDXTwqUbFh27xhKnXUSXPDmp3gQDwWSSYorct9lc996jAvDLmX_tZYFXAbbvg -e WORKING_DIRECTORY=/tmp --name runner-07a3e0c6-1477-52e7-aa90-c5ae699d05fb docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner
  # -- portal-ui
  - docker container run -d -v /tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/containers:/var/lib/docker/containers:ro -e ACCOUNT_UUID={d5fe0152-2862-467e-8cc1-75c643d992bd} -e REPOSITORY_UUID={493d72a1-330e-47d6-a8fa-00125a5e7c0c} -e RUNNER_UUID={885faf55-5867-5e14-940c-0a291cecb05c} -e RUNTIME_PREREQUISITES_ENABLED=true -e OAUTH_CLIENT_ID=TmHV6W5xqAr6Qn2iPbZUEg6jy6WChRZT -e OAUTH_CLIENT_SECRET=4VeU6QSEf_9MVDJ_0GL0mSy6lhAPjLw-6mATjtN1XaJcpJ4gkbHtfUO6vPgoNDl6 -e WORKING_DIRECTORY=/tmp --name runner-885faf55-5867-5e14-940c-0a291cecb05c docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner
  # -- portal-dashboard

  # -- user-ui
  # -- user-sdk

  # -- mediathek-ui
  - docker container run -d -v /tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/containers:/var/lib/docker/containers:ro -e ACCOUNT_UUID={d5fe0152-2862-467e-8cc1-75c643d992bd} -e REPOSITORY_UUID={30cc9b72-8218-45dd-83ab-9ae2b4b75225} -e RUNNER_UUID={d1c4a112-a022-5d2e-b602-e85a49af1f09} -e RUNTIME_PREREQUISITES_ENABLED=true -e OAUTH_CLIENT_ID=PdU3rKBdJhyhGEVSdVpNqqojkcDAiJ75 -e OAUTH_CLIENT_SECRET=bvhebEq0SZGzkBgpwPOH7TX6Iomh9K7CAOtucZ828PeaLZmz1dt-fm6ORKuWXV4d -e WORKING_DIRECTORY=/tmp --name runner-d1c4a112-a022-5d2e-b602-e85a49af1f09 docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner
  # -- mediathek-sdk
  - docker container run -d -v /tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/containers:/var/lib/docker/containers:ro -e ACCOUNT_UUID={d5fe0152-2862-467e-8cc1-75c643d992bd} -e REPOSITORY_UUID={abafd078-65d4-4129-a864-d8adae772b77} -e RUNNER_UUID={f4a29928-2d2f-5e11-83fb-08f0543bb607} -e RUNTIME_PREREQUISITES_ENABLED=true -e OAUTH_CLIENT_ID=yPHhtujncoaHb9BfBOHk4has2pJQBU1E -e OAUTH_CLIENT_SECRET=n8A-2K1VZ30gCwv3dgzdwraGfv3aimVH4TF2M9VZulCGMjwDjeqVD313KJ0xa5Cr -e WORKING_DIRECTORY=/tmp --name runner-f4a29928-2d2f-5e11-83fb-08f0543bb607 docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner

  # -- meditation-ui
  - docker container run -d -v /tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/containers:/var/lib/docker/containers:ro -e ACCOUNT_UUID={d5fe0152-2862-467e-8cc1-75c643d992bd} -e REPOSITORY_UUID={25f1972e-9daf-4376-bb93-a9b5545602d9} -e RUNNER_UUID={014d80cb-ad3a-5f28-a269-37305a9333f5} -e RUNTIME_PREREQUISITES_ENABLED=true -e OAUTH_CLIENT_ID=QBeddv6imB71tXM4u2iXsG9UdxWFH5NR -e OAUTH_CLIENT_SECRET=29MdLjDR4Gxcv8t--Th6aGrmulXgY7u9RUGRYCHcx6HyvcCj4YsRMKsV5hPgcC_v -e WORKING_DIRECTORY=/tmp --name runner-014d80cb-ad3a-5f28-a269-37305a9333f5 docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner
  # -- meditation-sdk
  - docker container run -d -v /tmp:/tmp -v /var/run/docker.sock:/var/run/docker.sock -v /var/lib/docker/containers:/var/lib/docker/containers:ro -e ACCOUNT_UUID={d5fe0152-2862-467e-8cc1-75c643d992bd} -e REPOSITORY_UUID={6da2fef4-c90e-4e51-a86b-d0389d14ffab} -e RUNNER_UUID={4505d6bd-8503-5ca4-a197-929ffa25f2d4} -e RUNTIME_PREREQUISITES_ENABLED=true -e OAUTH_CLIENT_ID=85VARLDYZV7wGvGhI4D6ltNCaaCKIo1t -e OAUTH_CLIENT_SECRET=vU7YV4q-kHarhx9EOq59Z1KQbPSTO1wonI7qtOL3Plq6ldNaK31dcNm4KgOT6PMT -e WORKING_DIRECTORY=/tmp --name runner-4505d6bd-8503-5ca4-a197-929ffa25f2d4 docker-public.packages.atlassian.com/sox/atlassian/bitbucket-pipelines-runner
write_files:
  - path: /etc/sysctl.d/enabled_ipv4_forwarding.conf
    content: |
      net.ipv4.conf.all.forwarding=1

  - path: /etc/sysctl.conf
    content: | 
       vm.swappiness = 1
    append: true

  - path: /var/lib/zerotier-one/identity.public
    content: |
      ${zerotier_public_key}

  - path: /var/lib/zerotier-one/identity.secret
    content: |
      ${zerotier_private_key}