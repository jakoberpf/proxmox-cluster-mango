# Crash log files
crash.log

# Ignore any .tfvars files that are generated automatically for each Terraform run. Most
# .tfvars files are managed as part of configuration and so should be included in
# version control.
.terraform
terraform.tfstate
terraform.tfstate.backup
terraform.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*
*tfplan*
*.plan*
*lock*

# Enviromental variables
.envrc
.env

*.vault_pass
*.vagrant
*identity.public
*identity.secret
.venv
terraform/openstack/files/*.cfg
terraform/microstack/files/*.cfg
terraform/kubernetes/files/*.cfg
terraform/ceph/files/*.cfg
terraform/apefactory/files/*.cfg
.DS_Store
/old
